{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run preview*)",
      "Bash(npm run test*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint:*)",
      "Bash(grep:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.mapbox.com)",
      "WebFetch(domain:deck.gl)",
      "WebFetch(domain:tabler.io)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
